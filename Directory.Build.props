<Project>

  <PropertyGroup>
    <!-- Single source of truth for the version of every package in this repo, so
         Godex, Godex.Async and Godex.Hosting can never disagree.

         CI (.github/workflows/ci.yml) bumps the patch component on every push to
         master, unless that commit changed this file by hand. -->
    <Version>0.1.1</Version>
  </PropertyGroup>

</Project>