<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>GodotEx.Hosting</PackageId>
    <Authors>altamkp</Authors>
    <Company>Qkabi Games</Company>
    <PackageDescription>Hosting extension library for Godot in C#.</PackageDescription>

    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <OutputType>Library</OutputType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>8618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../GodotEx/src/GodotEx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotnetEx.Hosting" Version="0.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
