<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>GodotEx</PackageId>
    <Authors>altamkp</Authors>
    <Company>Qkabi Games</Company>
    <PackageDescription>Extension library for Godot in C#.</PackageDescription>
    <RepositoryUrl>https://github.com/altamkp/GodotEx</RepositoryUrl>
    <PackageProjectUrl>https://altamkp.github.io/GodotEx/docs/GodotEx</PackageProjectUrl>

    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <OutputType>Library</OutputType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>8618,IDE0130</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotnetEx" Version="0.0.2" />
    <PackageReference Include="GodotSharp" Version="4.3.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
