<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Godex</PackageId>
    <Authors>altamkp</Authors>
    <Company>Qkabi Games</Company>
    <PackageDescription>Extension library for Godot in C#.</PackageDescription>
    <RepositoryUrl>https://github.com/altamkp/Godex</RepositoryUrl>
    <PackageProjectUrl>https://altamkp.github.io/Godex/docs/Godex</PackageProjectUrl>

    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <OutputType>Library</OutputType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>8618,IDE0130</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GodotSharp" Version="4.7.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
