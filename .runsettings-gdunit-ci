<?xml version="1.0" encoding="utf-8"?>
<!-- Headless runsettings, used by CI and scripted runs via "dotnet test". -->
<RunSettings>
    <RunConfiguration>
        <!-- Suites share engine singletons and the user:// directory, so run them serially. -->
        <MaxCpuCount>1</MaxCpuCount>
        <ResultsDirectory>./TestResults</ResultsDirectory>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <TestSessionTimeout>180000</TestSessionTimeout>
        <TreatNoTestsAsError>true</TreatNoTestsAsError>
    </RunConfiguration>

    <LoggerRunSettings>
        <Loggers>
            <Logger friendlyName="console" enabled="True">
                <Configuration>
                    <Verbosity>normal</Verbosity>
                </Configuration>
            </Logger>
            <Logger friendlyName="trx" enabled="True">
                <Configuration>
                    <LogFileName>test-result.trx</LogFileName>
                </Configuration>
            </Logger>
        </Loggers>
    </LoggerRunSettings>

    <GdUnit4>
        <!-- Additional Godot runtime parameters passed to the engine. -->
        <Parameters>--headless</Parameters>
        <!-- SimpleName or FullyQualifiedName -->
        <DisplayName>FullyQualifiedName</DisplayName>
        <!-- Generous: the first run also has to import the project. -->
        <GodotConnectTimeout>60000</GodotConnectTimeout>
    </GdUnit4>
</RunSettings>